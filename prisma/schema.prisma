// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WritingMode {
  PROSE
  SCREENPLAY
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  projects Project[]
  ideas    Idea[]
  series   Series[]
}

model Series {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  format    String?
  premise   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons    Season[]
  characters Character[]
  worldNotes WorldNote[]

  @@index([userId])
}

model Season {
  id        String   @id @default(cuid())
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number    Int
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes Project[]

  @@index([seriesId])
}

model Project {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  formatTemplate   String
  writingMode      WritingMode
  logline          String?
  status           ProjectStatus @default(ACTIVE)
  titlePageAuthor  String?
  titlePageContact String?
  titlePageBasedOn String?
  seasonId         String?
  season           Season?       @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  episodeNumber    Int?
  episodeTitle     String?
  storyBy          String?
  teleplayBy       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  ideas         Idea[]
  characters    Character[]
  outlineCards  OutlineCard[]
  worldNotes    WorldNote[]
  draft         Draft?

  @@index([seasonId])
}

model Idea {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

model Character {
  id            String   @id @default(cuid())
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seriesId      String?
  series        Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  arcNotes      String?
  relationships String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlineCards OutlineCard[]

  @@index([projectId])
  @@index([seriesId])
}

model OutlineCard {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  colorTag    String?
  act         String?
  location    String?
  emotion     String?
  storyThread String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters Character[]

  @@index([projectId])
}

model WorldNote {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seriesId    String?
  series      Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([seriesId])
}

model Draft {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content             Json
  wordCount           Int      @default(0)
  sceneNumbersLocked  Boolean  @default(false)
  lastLockedVersionId String?
  updatedAt           DateTime @updatedAt

  versions DraftVersion[]
  comments DraftComment[]
}

model DraftVersion {
  id            String   @id @default(cuid())
  draftId       String
  draft         Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  content       Json
  wordCount     Int      @default(0)
  label         String?
  revisionColor String?
  createdAt     DateTime @default(now())

  @@index([draftId])
}

model DraftComment {
  id        String   @id @default(cuid())
  draftId   String
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  elementId String
  text      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([draftId])
  @@index([elementId])
}
