// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WritingMode {
  PROSE
  SCREENPLAY
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  projects Project[]
  ideas    Idea[]
  series   Series[]
}

model Series {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  format    String?
  premise   String?
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  seasons    Season[]
  characters Character[]
  worldNotes WorldNote[]
  ideas      Idea[]
  beats      Beat[]
  references Reference[]

  @@index([userId])
}

model Season {
  id        String   @id @default(cuid())
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number    Int
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes   Project[]
  ideas      Idea[]
  beats      Beat[]
  references Reference[]

  @@index([seriesId])
}

// A lighter-weight, higher-level structural skeleton than OutlineCard (e.g.
// a Save the Cat-style beat sheet) — scoped to exactly one of a series, a
// season, or a project/episode, with an optional pointer down to the more
// granular OutlineCard it's been broken into once that happens.
model Beat {
  id           String       @id @default(cuid())
  seriesId     String?
  series       Series?      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonId     String?
  season       Season?      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  // Dual purpose, mirroring Idea: the primary scope when series/season are
  // both null (a beat on a standalone project's or episode's own beat
  // sheet), or an "assigned to this episode" narrowing when seasonId is set.
  projectId    String?
  project      Project?     @relation("BeatProject", fields: [projectId], references: [id], onDelete: SetNull)
  linkedCardId String?
  linkedCard   OutlineCard? @relation(fields: [linkedCardId], references: [id], onDelete: SetNull)
  title        String
  summary      String?
  order        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  references Reference[]

  @@index([seriesId])
  @@index([seasonId])
  @@index([projectId])
  @@index([linkedCardId])
}

model Project {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  formatTemplate   String
  writingMode      WritingMode
  logline          String?
  status           ProjectStatus @default(ACTIVE)
  titlePageAuthor  String?
  titlePageContact String?
  titlePageBasedOn String?
  seasonId         String?
  season           Season?       @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  episodeNumber    Int?
  episodeTitle     String?
  storyBy          String?
  teleplayBy       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  ideas         Idea[]
  characters    Character[]
  outlineCards  OutlineCard[]
  worldNotes    WorldNote[]
  beats         Beat[]        @relation("BeatProject")
  draft         Draft?

  @@index([seasonId])
}

model Idea {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seriesId  String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([seriesId])
  @@index([seasonId])
}

model Character {
  id            String   @id @default(cuid())
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seriesId      String?
  series        Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  arcNotes      String?
  relationships String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlineCards OutlineCard[]
  references   Reference[]

  @@index([projectId])
  @@index([seriesId])
}

model OutlineCard {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  colorTag    String?
  act         String?
  location    String?
  emotion     String?
  storyThread   String?
  linkedSceneId String?
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  characters  Character[]
  linkedBeats Beat[]

  @@index([projectId])
}

model WorldNote {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seriesId    String?
  series      Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  references Reference[]

  @@index([projectId])
  @@index([seriesId])
}

enum ReferenceKind {
  LINK
  FILE
}

// A pinned snippet — a link (song, article, video, Pinterest board) or an
// uploaded file (image, audio, PDF) — attached to exactly one of a world
// note, series, season, beat, or character. Files are stored in Vercel Blob;
// `url` holds the external URL for links and the Blob URL for files.
model Reference {
  id          String        @id @default(cuid())
  worldNoteId String?
  worldNote   WorldNote?    @relation(fields: [worldNoteId], references: [id], onDelete: Cascade)
  seriesId    String?
  series      Series?       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonId    String?
  season      Season?       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  beatId      String?
  beat        Beat?         @relation(fields: [beatId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character?    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  kind        ReferenceKind
  url         String
  label       String
  note        String?
  fileType    String?
  fileSize    Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([worldNoteId])
  @@index([seriesId])
  @@index([seasonId])
  @@index([beatId])
  @@index([characterId])
}

model Draft {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content             Json
  wordCount           Int      @default(0)
  sceneNumbersLocked  Boolean  @default(false)
  lastLockedVersionId String?
  updatedAt           DateTime @updatedAt

  versions DraftVersion[]
  comments DraftComment[]
}

model DraftVersion {
  id            String   @id @default(cuid())
  draftId       String
  draft         Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  content       Json
  wordCount     Int      @default(0)
  label         String?
  revisionColor String?
  createdAt     DateTime @default(now())

  @@index([draftId])
}

model DraftComment {
  id        String   @id @default(cuid())
  draftId   String
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  elementId String
  text      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([draftId])
  @@index([elementId])
}
