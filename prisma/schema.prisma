// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WritingMode {
  PROSE
  SCREENPLAY
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  // Daily writing goal in words; null means no goal set.
  dailyWordGoal Int?

  projects    Project[]
  ideas       Idea[]
  series      Series[]
  writingDays WritingDay[]
}

// One row per failed login, keyed by "email:<addr>" or "ip:<addr>", used to
// throttle PIN guessing. Rows are pruned as they age out of the window.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Words written on a given local calendar day (date is "YYYY-MM-DD" in the
// writer's own timezone), accumulated from positive draft word-count deltas.
model WritingDay {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String
  words  Int    @default(0)

  @@unique([userId, date])
}

model Series {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  format    String?
  premise   String?
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  seasons           Season[]
  characters        Character[]
  worldNotes        WorldNote[]
  ideas             Idea[]      @relation("IdeaSeries")
  promotedFromIdeas Idea[]      @relation("IdeaPromotedSeries")
  beats             Beat[]
  references        Reference[]

  @@index([userId])
}

model Season {
  id        String   @id @default(cuid())
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number    Int
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes   Project[]
  ideas      Idea[]
  beats      Beat[]
  references Reference[]

  @@index([seriesId])
}

// A lighter-weight, higher-level structural skeleton than OutlineCard (e.g.
// a Save the Cat-style beat sheet) — scoped to exactly one of a series, a
// season, or a project/episode, with an optional pointer down to the more
// granular OutlineCard it's been broken into once that happens.
model Beat {
  id           String        @id @default(cuid())
  seriesId     String?
  series       Series?       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonId     String?
  season       Season?       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  // Dual purpose, mirroring Idea: the primary scope when series/season are
  // both null (a beat on a standalone project's or episode's own beat
  // sheet), or an "assigned to this episode" narrowing when seasonId is set.
  projectId    String?
  project      Project?      @relation("BeatProject", fields: [projectId], references: [id], onDelete: SetNull)
  linkedCardId String?
  linkedCard   OutlineCard?  @relation(fields: [linkedCardId], references: [id], onDelete: SetNull)
  scenes       OutlineCard[] @relation("BeatScenes")
  title        String
  summary      String?
  order        Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  references Reference[]

  @@index([seriesId])
  @@index([seasonId])
  @@index([projectId])
  @@index([linkedCardId])
}

model Project {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  formatTemplate   String
  writingMode      WritingMode
  logline          String?
  status           ProjectStatus @default(ACTIVE)
  titlePageAuthor  String?
  titlePageContact String?
  titlePageBasedOn String?
  seasonId         String?
  season           Season?       @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  episodeNumber    Int?
  episodeTitle     String?
  storyBy          String?
  teleplayBy       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  ideas             Idea[]        @relation("IdeaProject")
  promotedFromIdeas Idea[]        @relation("IdeaPromotedProject")
  characters        Character[]
  outlineCards      OutlineCard[]
  worldNotes        WorldNote[]
  beats             Beat[]        @relation("BeatProject")
  draft             Draft?

  @@index([seasonId])
}

enum IdeaStatus {
  SPARK
  DEVELOPING
  PROMOTED
  ARCHIVED
}

model Idea {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Scope: the project/series/season this idea is filed under. All null means
  // it's a loose idea in the general inbox.
  projectId         String?
  project           Project?   @relation("IdeaProject", fields: [projectId], references: [id], onDelete: Cascade)
  seriesId          String?
  series            Series?    @relation("IdeaSeries", fields: [seriesId], references: [id], onDelete: SetNull)
  seasonId          String?
  season            Season?    @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  title             String?
  content           String
  tags              String[]   @default([])
  status            IdeaStatus @default(SPARK)
  // Set when the idea was developed into a new script or series.
  promotedProjectId String?
  promotedProject   Project?   @relation("IdeaPromotedProject", fields: [promotedProjectId], references: [id], onDelete: SetNull)
  promotedSeriesId  String?
  promotedSeries    Series?    @relation("IdeaPromotedSeries", fields: [promotedSeriesId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([seriesId])
  @@index([seasonId])
  @@index([status])
}

model Character {
  id            String   @id @default(cuid())
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seriesId      String?
  series        Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  arcNotes      String?
  relationships String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlineCards OutlineCard[]
  references   Reference[]

  @@index([projectId])
  @@index([seriesId])
}

model OutlineCard {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  summary       String?
  colorTag      String?
  act           String?
  location      String?
  emotion       String?
  storyThread   String?
  linkedSceneId String?
  // The project-level beat this scene sits under on the Plan board; null means
  // "unplanned". `order` stays the flattened story order across the board.
  beatId        String?
  beat          Beat?    @relation("BeatScenes", fields: [beatId], references: [id], onDelete: SetNull)
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  characters  Character[]
  // Legacy: the old one-way "beat points at a card" link, superseded by beatId.
  linkedBeats Beat[]

  @@index([projectId])
  @@index([beatId])
}

model WorldNote {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seriesId    String?
  series      Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  references Reference[]

  @@index([projectId])
  @@index([seriesId])
}

enum ReferenceKind {
  LINK
  FILE
}

// A pinned snippet — a link (song, article, video, Pinterest board) or an
// uploaded file (image, audio, PDF) — attached to exactly one of a world
// note, series, season, beat, or character. Files are stored in Vercel Blob;
// `url` holds the external URL for links and the Blob URL for files.
model Reference {
  id          String        @id @default(cuid())
  worldNoteId String?
  worldNote   WorldNote?    @relation(fields: [worldNoteId], references: [id], onDelete: Cascade)
  seriesId    String?
  series      Series?       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonId    String?
  season      Season?       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  beatId      String?
  beat        Beat?         @relation(fields: [beatId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character?    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  kind        ReferenceKind
  url         String
  label       String
  note        String?
  fileType    String?
  fileSize    Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([worldNoteId])
  @@index([seriesId])
  @@index([seasonId])
  @@index([beatId])
  @@index([characterId])
}

model Draft {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content             Json
  wordCount           Int      @default(0)
  sceneNumbersLocked  Boolean  @default(false)
  lastLockedVersionId String?
  // Bumped on every content write; saves are compare-and-set against it so
  // two tabs/devices can't silently overwrite each other.
  revision            Int      @default(0)
  updatedAt           DateTime @updatedAt

  versions DraftVersion[]
  comments DraftComment[]
}

model DraftVersion {
  id            String   @id @default(cuid())
  draftId       String
  draft         Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  content       Json
  wordCount     Int      @default(0)
  label         String?
  revisionColor String?
  createdAt     DateTime @default(now())

  @@index([draftId])
}

model DraftComment {
  id        String   @id @default(cuid())
  draftId   String
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  elementId String
  text      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([draftId])
  @@index([elementId])
}
