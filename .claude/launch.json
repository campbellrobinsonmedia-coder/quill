{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quill-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "quill-dev-email",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EMAIL_TRANSPORT=console",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
